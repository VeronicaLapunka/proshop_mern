    {
      "parameters": {
        "jsCode": " const logs = $input.all().map(item => item.json).filter(e => e && e.timestamp && e.status);\n\n  const now = Date.now();\n  const window_ms = 60 * 1000;\n  const recent = logs.filter(e => (now - new Date(e.timestamp).getTime()) < window_ms);\n\n  const total = recent.length;\n  const errors = recent.filter(e => e.status === 'error').length;\n  const error_rate = total > 0 ? errors / total : 0;\n\n  return [{ json: {\n    feature_id: 'search_v2',\n    error_rate: Math.round(error_rate * 1000) / 1000,\n    total,\n    errors\n  }}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
