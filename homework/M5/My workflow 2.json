      "parameters": {
        "jsCode": "const agg = $('Code in JavaScript').first().json;\n  const featureId = agg.feature_id;\n  const errorRate = agg.error_rate;\n  const currentStatus = $input.first().json[featureId].status;\n\n  let decision = 'noop';\n  if (errorRate > 0.05 && currentStatus !== 'Disabled') {\n    decision = 'deactivate';\n  } else if (errorRate < 0.01 && currentStatus === 'Disabled') {\n    decision = 're_enable';\n  }\n\n  return [{ json: { feature_id: featureId, error_rate: errorRate, current_status: currentStatus, decision } }];"
      },
